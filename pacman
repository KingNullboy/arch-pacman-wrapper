#!/bin/bash

set -e

CONTAINER="arch-pacman"
CONTAINER_DIR="/workspace"
IMAGE="archlinux"

# ---- helpers ----

container_running() {
  docker ps --format '{{.Names}}' | grep -q "^$CONTAINER$"
}

ensure_container() {
  if container_running; then
    return
  fi

  echo "Container '$CONTAINER' not running. Starting it..."

  docker run -dit \
    --name "$CONTAINER" \
    -v "$(pwd)":$CONTAINER_DIR \
    -w "$CONTAINER_DIR" \
    "$IMAGE" bash >/dev/null
}

# ---- main logic ----

ensure_container

# shell mode
if [ "$1" == "shell" ]; then
  shift
  docker exec -it "$CONTAINER" bash
  exit 0
fi

# direct run mode
if [ "$1" == "run" ]; then
  shift
  docker exec -it \
    -w "$CONTAINER_DIR" \
    -e HOME=/root \
    "$CONTAINER" "$@"
  exit 0
fi

# pacman passthrough (default)
docker exec -it \
  -w "$CONTAINER_DIR" \
  -e HOME=/root \
  "$CONTAINER" pacman "$@"
